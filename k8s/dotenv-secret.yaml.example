# Copy this file to `k8s/dotenv-secret.yaml` and fill in your real credentials locally.
# `k8s/dotenv-secret.yaml` is ignored by Git so secrets are never pushed.
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-secret
  namespace: devops-assessment
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {
      "auths": {
        "ghcr.io": {
          "username": "<YOUR_GITHUB_USERNAME>",
          "password": "<YOUR_GHCR_TOKEN>"
        }
      }
    }
