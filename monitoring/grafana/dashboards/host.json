        {
          "expr": "avg by (instance) (rate(node_cpu_seconds_total{mode=\"system\"}[1m])) * 100",
          "legendFormat": "System",
          "refId": "C"
        },
        {
          "expr": "avg by (instance) (rate(node_cpu_seconds_total{mode=\"iowait\"}[1m])) * 100",
          "legendFormat": "I/O Wait",
          "refId": "D"
        }
      ]
    },
