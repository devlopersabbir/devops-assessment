        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"devops-assessment.*|cadvisor|node-exporter|prometheus|grafana|loki|alloy\"}[1m])) by (name) * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Per-Container Working Set Memory",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{name=~\"devops-assessment.*|cadvisor|node-exporter|prometheus|grafana|loki|alloy\"}) by (name)",
          "legendFormat": "{{name}} (Used)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "title": "Container Memory Usage Relative to Configured Limit (%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(sum(container_memory_working_set_bytes{name=~\"devops-assessment.*\"}) by (name) / sum(container_spec_memory_limit_bytes{name=~\"devops-assessment.*\"}) by (name)) * 100",
          "legendFormat": "{{name}} (% of Limit)",
          "refId": "A"
        }
      ]
